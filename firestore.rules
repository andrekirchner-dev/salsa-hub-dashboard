rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── Códigos de cargo (legado) ─────────────────────────────────────────────
    match /cargoCodes/{code} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── Role Codes (Admin Panel) ──────────────────────────────────────────────
    // Qualquer autenticado pode LER para validar no SetupProfile.
    // Apenas o owner (kirchner.andre@gmail.com) pode escrever.
    function isAppOwner() {
      return isAuthenticated() && (
        request.auth.token.email == "kirchner.andre@gmail.com" ||
        request.auth.token.email == "lucas.xaviercr97@gmail.com"
      );
    }

    match /roleCodes/{codeId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAppOwner();
      allow update: if isAppOwner() || (
        // Allow incrementing usedCount during profile setup
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usedCount"])
      );
    }

    // ── Perfis de usuário ─────────────────────────────────────────────────────
    // Qualquer usuário autenticado pode LER perfis (busca de contatos no Chat
    // e no sistema de convites da equipe).
    // Apenas o próprio usuário pode ESCREVER seu perfil.
    match /profiles/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid);
    }

    // ── Dados pessoais do usuário ─────────────────────────────────────────────
    // Toda a árvore users/{uid}/** é isolada por uid.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // ── Notificações cross-user ───────────────────────────────────────────────
    // Qualquer usuário autenticado pode CRIAR notificações para outro usuário
    // (ex: convites de equipe, menções no chat).
    // Apenas o dono pode LER e atualizar as suas.
    match /users/{uid}/notifications/{notifId} {
      allow read, update, delete: if isOwner(uid);
      allow create: if isAuthenticated();
    }

    // ── Dados administrativos ─────────────────────────────────────────────────
    match /admin/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // ── Convites de equipe ────────────────────────────────────────────────────
    // Qualquer usuário autenticado pode criar convites.
    // O criador e o convidado (matched por email) podem ler e atualizar.
    match /invites/{inviteId} {
      allow create: if isAuthenticated();

      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.inviterUid ||
        request.auth.token.email == resource.data.inviteeEmail
      );

      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.inviterUid ||
        request.auth.token.email == resource.data.inviteeEmail
      );

      allow delete: if isAuthenticated() &&
        request.auth.uid == resource.data.inviterUid;
    }

    // ── Conversas (Chat) ──────────────────────────────────────────────────────
    match /conversations/{convId} {
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.participantUids;

      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participantUids;

      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participantUids;

      // Mensagens dentro da conversa
      match /messages/{msgId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantUids;

        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantUids
          && request.resource.data.authorUid == request.auth.uid;

        allow update, delete: if isAuthenticated()
          && request.auth.uid == resource.data.authorUid;
      }
    }

    // ── Tarefas globais (atribuídas a pessoas ou equipes) ────────────────────
    // O criador e o destinatário (por uid ou equipe) podem ler e atualizar.
    // Apenas o criador pode deletar.
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
        resource.data.createdByUid == request.auth.uid ||
        resource.data.assignedToUid == request.auth.uid
      );

      allow create: if isAuthenticated()
        && request.resource.data.createdByUid == request.auth.uid;

      allow update: if isAuthenticated() && (
        resource.data.createdByUid == request.auth.uid ||
        resource.data.assignedToUid == request.auth.uid
      );

      allow delete: if isAuthenticated()
        && resource.data.createdByUid == request.auth.uid;

      // Subtarefas das tarefas globais
      match /subtasks/{subtaskId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/tasks/$(taskId)).data.createdByUid == request.auth.uid ||
          get(/databases/$(database)/documents/tasks/$(taskId)).data.assignedToUid == request.auth.uid
        );
      }
    }

    // ── Bloqueia tudo o mais ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
