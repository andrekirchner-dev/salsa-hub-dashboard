rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // App owners (admins) — emails verificados pelo Firebase Auth token.
    // Para alterar admins, basta mudar aqui e fazer redeploy das rules.
    function isAppOwner() {
      return isAuthenticated() && (
        request.auth.token.email == "kirchner.andre@gmail.com" ||
        request.auth.token.email == "lucas.xaviercr97@gmail.com"
      );
    }

    // Retorna o cargo do usuário autenticado a partir do seu perfil.
    // Usado para validar permissões de criação de roleCodes.
    function getUserRole() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role;
    }

    // ── Configuração administrativa (hashes de PIN, etc.) ─────────────────────
    // Somente app owners podem ler/escrever. Usuários comuns recebem negação,
    // nunca enxergam os hashes.
    match /adminConfig/{docId} {
      allow read, write: if isAppOwner();
    }

    // ── Empresas (coleção global) ─────────────────────────────────────────────
    // Uma empresa por CEO (companyId == ownerUid).
    // Qualquer autenticado pode LER (busca de empresa de colegas, vinculação
    // de produtos entre empresas).
    // Apenas o dono da empresa (CEO) pode escrever.
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(companyId) || isAppOwner();
    }

    // ── Códigos de cargo (legado, somente leitura) ────────────────────────────
    match /cargoCodes/{code} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── Role Codes ────────────────────────────────────────────────────────────
    // LEITURA: qualquer autenticado pode ler para validar no SetupProfile.
    // CRIAÇÃO: apenas app owners OU usuários com cargo CEO/CFO (validado no server).
    //   Como o campo 'role' do perfil é agora imutável pelo próprio usuário
    //   (veja regra de profiles abaixo), CEO real == CEO aprovado pelo admin.
    // ATUALIZAÇÃO restrita:
    //   - Owner do código (CEO/CFO) pode alterar campos do próprio código.
    //   - Qualquer autenticado pode incrementar usedCount e alternar active
    //     (necessário para SetupProfile e AdminPanel).
    // EXCLUSÃO: app owners ou o criador do código (CEO/CFO).
    match /roleCodes/{codeId} {
      allow read: if isAuthenticated();

      allow create: if isAppOwner()
        || (isAuthenticated() && getUserRole() in ["CEO", "CFO"]);

      allow update: if isAppOwner()
        || (isAuthenticated()
            && getUserRole() in ["CEO", "CFO"]
            && resource.data.createdBy == request.auth.uid)
        || (isAuthenticated()
            && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(["usedCount", "active"]));

      allow delete: if isAppOwner()
        || (isAuthenticated()
            && resource.data.createdBy == request.auth.uid
            && getUserRole() in ["CEO", "CFO"]);
    }

    // ── Link Codes (compartilhamento de produto por CEO) ──────────────────────
    // Criação: dono do código deve ser o usuário autenticado.
    // Atualização: dono altera qualquer campo; outros só incrementam usedCount
    //   (a lógica de limite é enforced via runTransaction no cliente).
    match /linkCodes/{codeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid
        || request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["usedCount"])
      );
    }

    // ── Perfis de usuário ─────────────────────────────────────────────────────
    // LEITURA: qualquer autenticado (busca de contatos, convites, etc.).
    // CRIAÇÃO: apenas o próprio usuário (no SetupProfile, cargo vem do roleCode).
    // ATUALIZAÇÃO:
    //   - Usuário pode atualizar qualquer campo do próprio perfil EXCETO 'role'.
    //     Isso impede auto-promoção de cargo via console/DevTools.
    //   - App owners podem atualizar qualquer campo, inclusive 'role' (gestão admin).
    match /profiles/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid);
      allow update: if
        (isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"]))
        || isAppOwner();
    }

    // ── Dados pessoais do usuário ─────────────────────────────────────────────
    // Toda a árvore users/{uid}/** é isolada por uid por padrão.
    // Regras mais específicas abaixo sobrepõem este catch-all para subcoleções
    // que precisam de escrita cross-user.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // ── Notificações cross-user ───────────────────────────────────────────────
    // Qualquer autenticado pode CRIAR (ex: convites, menções).
    // Apenas o dono pode ler, atualizar e deletar as suas.
    match /users/{uid}/notifications/{notifId} {
      allow read, update, delete: if isOwner(uid);
      allow create: if isAuthenticated();
    }

    // ── SharedProducts cross-user ─────────────────────────────────────────────
    // Qualquer autenticado pode criar/atualizar (ao adicionar membro a produto).
    // Apenas o dono pode ler e deletar.
    match /users/{uid}/sharedProducts/{productId} {
      allow read: if isOwner(uid);
      allow create, update: if isAuthenticated();
      allow delete: if isOwner(uid);
    }

    // ── Meetings cross-user ───────────────────────────────────────────────────
    // Criador da reunião/evento escreve na subcoleção de cada participante.
    // Apenas o dono pode ler, atualizar e deletar as suas.
    match /users/{uid}/meetings/{meetingId} {
      allow read, update, delete: if isOwner(uid);
      allow create: if isAuthenticated();
    }

    // ── Equipe do produto (cross-user restrito) ───────────────────────────────
    // LEITURA: dono do produto ou qualquer autenticado (membros precisam ver).
    // ESCRITA: APENAS o dono do produto.
    //   Isso impede que qualquer usuário autenticado injete membros em produtos
    //   alheios via console/DevTools (vulnerabilidade corrigida).
    //   Shared product viewers que queiram adicionar membros devem pedir ao dono.
    match /users/{uid}/products/{productId}/team/{memberId} {
      allow read: if isOwner(uid) || isAuthenticated();
      allow write: if isOwner(uid);
    }

    // ── Perfil de empresa (CEO) ───────────────────────────────────────────────
    match /users/{uid}/company/{docId} {
      allow read, write: if isOwner(uid);
    }

    // ── Dados administrativos ─────────────────────────────────────────────────
    match /admin/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // ── Convites de equipe ────────────────────────────────────────────────────
    // Criador e convidado (matched por email) podem ler e atualizar.
    match /invites/{inviteId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.inviterUid ||
        request.auth.token.email == resource.data.inviteeEmail
      );
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.inviterUid ||
        request.auth.token.email == resource.data.inviteeEmail
      );
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.inviterUid;
    }

    // ── Conversas (Chat) ──────────────────────────────────────────────────────
    match /conversations/{convId} {
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.participantUids;
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participantUids;
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participantUids;
      allow delete: if isAuthenticated()
        && request.auth.uid in resource.data.participantUids;

      match /messages/{msgId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantUids;
        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantUids
          && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isAuthenticated()
          && request.auth.uid == resource.data.authorUid;
      }
    }

    // ── Tarefas globais ───────────────────────────────────────────────────────
    // Criador e qualquer destinatário (assignedToUids[]) podem ler e atualizar.
    // Apenas o criador pode deletar.
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
        resource.data.createdByUid == request.auth.uid ||
        request.auth.uid in resource.data.assignedToUids
      );
      allow create: if isAuthenticated()
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.createdByUid == request.auth.uid ||
        request.auth.uid in resource.data.assignedToUids
      );
      allow delete: if isAuthenticated()
        && resource.data.createdByUid == request.auth.uid;

      match /subtasks/{subtaskId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/tasks/$(taskId)).data.createdByUid == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/tasks/$(taskId)).data.assignedToUids
        );
      }
    }

    // ── Logs de auditoria ─────────────────────────────────────────────────────
    // Qualquer autenticado pode CRIAR (grava ação própria).
    // LEITURA e DELEÇÃO apenas para app owners (compliance).
    // Sem allow update — logs são imutáveis.
    match /auditLogs/{logId} {
      allow create: if isAuthenticated()
        && request.resource.data.actorUid == request.auth.uid;
      allow read, delete: if isAppOwner();
    }

    // ── Bloqueia tudo o mais ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
