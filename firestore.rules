rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── Códigos de cargo (legado) ─────────────────────────────────────────────
    match /cargoCodes/{code} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── Role Codes (Admin Panel + CEO) ───────────────────────────────────────
    // Qualquer autenticado pode LER para validar no SetupProfile.
    // Admins OU qualquer usuário autenticado podem CRIAR (CEOs geram via Team.tsx).
    function isAppOwner() {
      return isAuthenticated() && (
        request.auth.token.email == "kirchner.andre@gmail.com" ||
        request.auth.token.email == "lucas.xaviercr97@gmail.com"
      );
    }

    match /roleCodes/{codeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // CEOs and admins can create role codes
      allow delete: if isAppOwner() || (isAuthenticated() && resource.data.createdBy == request.auth.uid);
      allow update: if isAppOwner() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usedCount"])
      );
    }

    // ── Link Codes (CEO product sharing) ─────────────────────────────────────
    // CEOs create codes pointing to their products.
    // Any authenticated user can READ to validate a code.
    // Only the creator can delete; anyone can increment usedCount.
    match /linkCodes/{codeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usedCount"])
      );
    }

    // ── Perfis de usuário ─────────────────────────────────────────────────────
    // Qualquer usuário autenticado pode LER perfis (busca de contatos no Chat
    // e no sistema de convites da equipe).
    // Apenas o próprio usuário pode ESCREVER seu perfil.
    match /profiles/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid);
    }

    // ── Dados pessoais do usuário ─────────────────────────────────────────────
    // Toda a árvore users/{uid}/** é isolada por uid.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // ── Notificações cross-user ───────────────────────────────────────────────
    // Qualquer usuário autenticado pode CRIAR notificações para outro usuário
    // (ex: convites de equipe, menções no chat).
    // Apenas o dono pode LER e atualizar as suas.
    match /users/{uid}/notifications/{notifId} {
      allow read, update, delete: if isOwner(uid);
      allow create: if isAuthenticated();
    }

    // ── SharedProducts cross-user ─────────────────────────────────────────────
    // Any authenticated user can write a sharedProduct entry to another user's
    // subcollection (e.g. when adding them to a product team).
    // Only the owner can read their own sharedProducts.
    match /users/{uid}/sharedProducts/{productId} {
      allow read: if isOwner(uid);
      allow create, update: if isAuthenticated();
      allow delete: if isOwner(uid);
    }

    // ── Meetings cross-user ───────────────────────────────────────────────────
    // Meeting creator writes to each participant's meetings subcollection.
    // Only the owner can read their own meetings.
    match /users/{uid}/meetings/{meetingId} {
      allow read, update, delete: if isOwner(uid);
      allow create: if isAuthenticated();
    }

    // ── Product team cross-user ───────────────────────────────────────────────
    // Product owner or authenticated members can write to the team subcollection.
    match /users/{uid}/products/{productId}/team/{memberId} {
      allow read: if isOwner(uid) || isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Company profile (CEO) ─────────────────────────────────────────────────
    match /users/{uid}/company/{docId} {
      allow read, write: if isOwner(uid);
    }

    // ── Dados administrativos ─────────────────────────────────────────────────
    match /admin/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // ── Convites de equipe ────────────────────────────────────────────────────
    // Qualquer usuário autenticado pode criar convites.
    // O criador e o convidado (matched por email) podem ler e atualizar.
    match /invites/{inviteId} {
      allow create: if isAuthenticated();

      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.inviterUid ||
        request.auth.token.email == resource.data.inviteeEmail
      );

      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.inviterUid ||
        request.auth.token.email == resource.data.inviteeEmail
      );

      allow delete: if isAuthenticated() &&
        request.auth.uid == resource.data.inviterUid;
    }

    // ── Conversas (Chat) ──────────────────────────────────────────────────────
    match /conversations/{convId} {
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.participantUids;

      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participantUids;

      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participantUids;

      allow delete: if isAuthenticated()
        && request.auth.uid in resource.data.participantUids;

      // Mensagens dentro da conversa
      match /messages/{msgId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantUids;

        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantUids
          && request.resource.data.authorUid == request.auth.uid;

        allow update, delete: if isAuthenticated()
          && request.auth.uid == resource.data.authorUid;
      }
    }

    // ── Tarefas globais (atribuídas a pessoas ou equipes) ────────────────────
    // O criador e qualquer destinatário (assignedToUids array) podem ler e atualizar.
    // Apenas o criador pode deletar.
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
        resource.data.createdByUid == request.auth.uid ||
        request.auth.uid in resource.data.assignedToUids
      );

      allow create: if isAuthenticated()
        && request.resource.data.createdByUid == request.auth.uid;

      allow update: if isAuthenticated() && (
        resource.data.createdByUid == request.auth.uid ||
        request.auth.uid in resource.data.assignedToUids
      );

      allow delete: if isAuthenticated()
        && resource.data.createdByUid == request.auth.uid;

      // Subtarefas das tarefas globais
      match /subtasks/{subtaskId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/tasks/$(taskId)).data.createdByUid == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/tasks/$(taskId)).data.assignedToUids
        );
      }
    }

    // ── Bloqueia tudo o mais ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
